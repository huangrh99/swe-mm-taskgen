{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-capability-classifier-v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "visual_capabilities"],
  "properties": {
    "schema_version": {"const": "visual-capability-classifier-v4"},
    "task_id": {"type": "string", "minLength": 1},
    "visual_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "importance", "visual_evidence", "task_relation"],
        "properties": {
          "category": {
            "enum": [
              "rendering_appearance_understanding",
              "spatial_layout_understanding",
              "element_state_understanding",
              "interaction_temporal_understanding"
            ]
          },
          "importance": {"enum": ["core", "supporting"]},
          "visual_evidence": {"type": "string", "minLength": 1},
          "task_relation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

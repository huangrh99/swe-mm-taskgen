{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "existing-tests-extension-v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "behavioral_contract", "coverage", "test_bundles", "oracle_quality_plan", "missing_context", "summary", "human_review_required", "human_review_reasons"],
  "properties": {
    "schema_version": {"const": "existing-tests-extension-v3"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["not_applicable_unfrozen_task", "no_additional_tests_needed", "additional_tests_proposed", "coverage_gap_but_insufficient_context", "human_review_required"]},
    "behavioral_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["observable_requirements", "preserved_behaviors", "implementation_variation"],
      "properties": {
        "observable_requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "contract"], "properties": {
          "requirement_id": {"type": "string", "minLength": 1}, "contract": {"type": "string", "minLength": 1}
        }}},
        "preserved_behaviors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "implementation_variation": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "visual_category", "coverage", "existing_test_ids", "assertion_summary", "reason"], "properties": {
      "requirement_id": {"type": "string", "minLength": 1},
      "visual_category": {"$ref": "#/$defs/visual_category"},
      "coverage": {"enum": ["直接覆盖", "间接覆盖", "未覆盖", "当前信息不足"]},
      "existing_test_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "assertion_summary": {"type": "string"}, "reason": {"type": "string", "minLength": 1}
    }}},
    "test_bundles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["bundle_id", "template_test_ids", "target_requirement_ids", "target_visual_capabilities", "coverage_gap_reason", "why_assertions_measure_requirements", "oracle_type", "predicted_transition", "predicted_base_behavior", "predicted_reference_behavior", "working_directory", "test_command", "stable_test_ids", "files", "unified_test_patch", "result_parser", "environment_assumptions", "execution_preflight", "equivalence_self_check", "vacuous_pass_checks", "surface_signal_resistance"], "properties": {
      "bundle_id": {"type": "string", "minLength": 1},
      "template_test_ids": {"type": "array", "items": {"type": "string"}},
      "target_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "target_visual_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/visual_category"}},
      "coverage_gap_reason": {"type": "string", "minLength": 1},
      "why_assertions_measure_requirements": {"type": "string", "minLength": 1},
      "oracle_type": {"enum": ["rendered_structure_state_assertion", "numeric_layout_geometry_assertion", "computed_style_or_rendered_property_assertion", "snapshot_or_pixel_diff", "interaction_trace", "domain_semantic_assertion", "vlm_judge"]},
      "predicted_transition": {"enum": ["candidate_f2p", "candidate_p2p", "unknown"]},
      "predicted_base_behavior": {"type": "string", "minLength": 1},
      "predicted_reference_behavior": {"type": "string", "minLength": 1},
      "working_directory": {"type": "string"}, "test_command": {"type": "string", "minLength": 1},
      "stable_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "operation", "content", "sha256_before"], "properties": {
        "path": {"type": "string", "minLength": 1}, "operation": {"enum": ["add", "modify"]}, "content": {"type": "string", "minLength": 1}, "sha256_before": {"type": ["string", "null"]}
      }}},
      "unified_test_patch": {"type": "string", "minLength": 1},
      "result_parser": {"type": "string", "minLength": 1},
      "environment_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "execution_preflight": {"type": "object", "additionalProperties": false, "required": ["command_evidence", "collection_evidence", "import_and_mock_evidence", "observable_oracle_evidence", "parallel_isolation", "precondition_failures"], "properties": {
        "command_evidence": {"type": "string", "minLength": 1},
        "collection_evidence": {"type": "string", "minLength": 1},
        "import_and_mock_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observable_oracle_evidence": {"type": "string", "minLength": 1},
        "parallel_isolation": {"type": "string", "minLength": 1},
        "precondition_failures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }},
      "equivalence_self_check": {"type": "string", "minLength": 1},
      "vacuous_pass_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "surface_signal_resistance": {"type": "string", "minLength": 1}
    }}},
    "oracle_quality_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "curator_only", "negative_variants", "equivalent_positive_variant"],
      "properties": {
        "status": {"const": "proposed_not_executed"}, "curator_only": {"const": true},
        "negative_variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["variant_id", "defect_preserved_or_introduced", "expected_failure_test_ids"], "properties": {
          "variant_id": {"type": "string", "minLength": 1}, "defect_preserved_or_introduced": {"type": "string", "minLength": 1}, "expected_failure_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }}},
        "equivalent_positive_variant": {"type": "object", "additionalProperties": false, "required": ["description", "expected_pass_test_ids"], "properties": {
          "description": {"type": "string", "minLength": 1}, "expected_pass_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }}
      }
    },
    "missing_context": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1},
    "human_review_required": {"type": "boolean"},
    "human_review_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"visual_category": {"enum": ["外观与渲染属性理解", "空间布局与几何理解", "元素结构与视觉状态理解", "动态交互与时序理解", "图形符号与领域语义理解"]}}
}

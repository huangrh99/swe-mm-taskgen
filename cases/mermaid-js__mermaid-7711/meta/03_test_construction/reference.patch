+const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
+
+const getDefaultSelfLoopSide = (rankdir = 'TB') => {
+  switch (rankdir) {
+    case 'BT':
+      return 'bottom';
+    case 'LR':
+      return 'right';
+    case 'RL':
+      return 'left';
+    case 'TB':

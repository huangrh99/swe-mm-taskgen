+import type { UIEvent } from 'react';
+
+const recordScroll = (event: UIEvent<HTMLDivElement>) => {
+  const element = event.currentTarget;
+  element.dataset.scrollEvents = String(Number(element.dataset.scrollEvents ?? '0') + 1);
+  element.dataset.scrollTargetIsWrapper = String(event.target === element);
+  element.dataset.scrollCurrentTargetIsWrapper = String(event.currentTarget === element);
+};
+
+export default {
+  flowProps: {
+    defaultViewport: { x: 0, y: 0, zoom: 1 },
+    minZoom: 0.1,
+    maxZoom: 4,
+    onScroll: recordScroll,
+    nodes: [
+      { id: 'focus-anchor', data: { label: 'Focus anchor' }, position: { x: 20, y: 20 } },
+      { id: 'focus-middle', data: { label: 'Focus middle' }, position: { x: 350, y: 350 } },
+      { id: 'focus-target', data: { label: 'Focus target' }, position: { x: 800, y: 800 } },
+    ],
+    edges: [],
+  },
+} satisfies FlowConfig;
diff --git a/tests/playwright/e2e/focus.spec.ts b/tests/playwright/e2e/focus.spec.ts
new file mode 100644
--- /dev/null
+++ b/tests/playwright/e2e/focus.spec.ts
@@ -0,0 +1,104 @@
+import { test, expect, type Locator, type Page } from '@playwright/test';
+
+import { getTransform } from './utils';
+
+const route = '/tests/generic/focus/general';
+
+function node(page: Page, id: string): Locator {
+  return page.getByTestId(`rf__node-${id}`);
+}
+
+async function scrollState(wrapper: Locator) {
+  return wrapper.evaluate((element) => ({
+    left: (element as HTMLElement).scrollLeft,
+    top: (element as HTMLElement).scrollTop,
+  }));
+}
+
+async function scrollCallbackCount(wrapper: Locator) {
+  return wrapper.evaluate((element) => Number((element as HTMLElement).dataset.scrollEvents ?? '0'));
+}
+
+test.describe('Node focus viewport behavior', () => {
+  test.beforeEach(async ({ page }) => {
+    await page.setViewportSize({ width: 800, height: 600 });
+    await page.goto(route);
+    await expect(page.getByTestId('rf__wrapper')).toBeAttached();
+    await expect(node(page, 'focus-anchor')).toBeAttached();
+    await expect(node(page, 'focus-target')).toBeAttached();
+  });
+
+  test('[xyflow-4991-focus-scroll-01] tabbing to offscreen nodes preserves the visual viewport', async ({ page }) => {
+    const wrapper = page.getByTestId('rf__wrapper');
+    const viewport = page.locator('.react-flow__viewport');
+    const anchor = node(page, 'focus-anchor');
+    const middle = node(page, 'focus-middle');
+    const target = node(page, 'focus-target');
+
+    await anchor.hover();
+    await page.mouse.wheel(0, -5000);
+    await expect.poll(async () => (await getTransform(viewport)).scale).toBe(4);
+
+    const wrapperBox = await wrapper.boundingBox();
+    const middleBoxBeforeFocus = await middle.boundingBox();
+    const targetBoxBeforeFocus = await target.boundingBox();
+    expect(wrapperBox).not.toBeNull();
+    expect(middleBoxBeforeFocus).not.toBeNull();
+    expect(targetBoxBeforeFocus).not.toBeNull();
+    expect(middleBoxBeforeFocus!.x).toBeGreaterThan(wrapperBox!.x + wrapperBox!.width);
+    expect(middleBoxBeforeFocus!.y).toBeGreaterThan(wrapperBox!.y + wrapperBox!.height);
+    expect(targetBoxBeforeFocus!.x).toBeGreaterThan(wrapperBox!.x + wrapperBox!.width);
+    expect(targetBoxBeforeFocus!.y).toBeGreaterThan(wrapperBox!.y + wrapperBox!.height);
+
+    await anchor.evaluate((element) => (element as HTMLElement).focus());
+    await expect(anchor).toBeFocused();
+    const scrollBeforeFocus = await scrollState(wrapper);
+    const transformBeforeFocus = await getTransform(viewport);
+    await page.keyboard.press('Tab');
+    await expect(middle).toBeFocused();
+    await expect.poll(() => scrollState(wrapper)).toEqual(scrollBeforeFocus);
+    await expect.poll(() => getTransform(viewport)).toEqual(transformBeforeFocus);
+    await page.keyboard.press('Tab');
+    await expect(target).toBeFocused();
+    await expect.poll(() => scrollState(wrapper)).toEqual(scrollBeforeFocus);
+    await expect.poll(() => getTransform(viewport)).toEqual(transformBeforeFocus);
+  });
+
+  test('[xyflow-4991-focus-scroll-03] consumer onScroll receives native wrapper scroll events', async ({ page }) => {
+    const wrapper = page.getByTestId('rf__wrapper');
+    const anchor = node(page, 'focus-anchor');
+    await anchor.hover();
+    await page.mouse.wheel(0, -5000);
+    await expect.poll(async () => (await getTransform(page.locator('.react-flow__viewport'))).scale).toBe(4);
+    const countBefore = await scrollCallbackCount(wrapper);
+    await wrapper.evaluate((element) => {
+      element.scrollTo({ left: 64, top: 96 });
+    });
+    await expect.poll(() => scrollCallbackCount(wrapper)).toBeGreaterThan(countBefore);
+    await expect.poll(() => wrapper.getAttribute('data-scroll-target-is-wrapper')).toBe('true');
+    await expect.poll(() => wrapper.getAttribute('data-scroll-current-target-is-wrapper')).toBe('true');
+  });
+
+  test('[xyflow-4991-focus-scroll-02] directly focusing an offscreen node preserves the viewport', async ({ page }) => {
+    const wrapper = page.getByTestId('rf__wrapper');
+    const viewport = page.locator('.react-flow__viewport');
+    const anchor = node(page, 'focus-anchor');
+    const target = node(page, 'focus-target');
+
+    await anchor.hover();
+    await page.mouse.wheel(0, -5000);
+    await expect.poll(async () => (await getTransform(viewport)).scale).toBe(4);
+    const targetBox = await target.boundingBox();
+    const wrapperBox = await wrapper.boundingBox();
+    expect(targetBox).not.toBeNull();
+    expect(wrapperBox).not.toBeNull();
+    expect(targetBox!.x).toBeGreaterThan(wrapperBox!.x + wrapperBox!.width);
+    expect(targetBox!.y).toBeGreaterThan(wrapperBox!.y + wrapperBox!.height);
+    const scrollBeforeFocus = await scrollState(wrapper);
+    const transformBeforeFocus = await getTransform(viewport);
+    await target.evaluate((element) => (element as HTMLElement).focus());
+    await expect(target).toBeFocused();
+    await expect.poll(() => scrollState(wrapper)).toEqual(scrollBeforeFocus);
+    await expect.poll(() => getTransform(viewport)).toEqual(transformBeforeFocus);
+  });
+});

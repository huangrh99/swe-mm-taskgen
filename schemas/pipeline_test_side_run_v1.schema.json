{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-test-side-run-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "side", "repetition", "trial_id", "job_id", "native_task_checksum", "agent", "native_reward", "repository", "baseline_commit",
    "reference_commit", "tested_commit", "task_sha256", "test_manifest_sha256",
    "test_payload_sha256", "command", "environment", "started_at", "finished_at",
    "exit_code", "harbor_result", "raw_output", "results", "summary"
  ],
  "properties": {
    "schema_version": {"const": "pipeline-test-side-run-v1"},
    "side": {"enum": ["baseline", "reference"]},
    "repetition": {"type": "integer", "minimum": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "native_task_checksum": {"$ref": "#/$defs/sha256"},
    "agent": {"enum": ["nop", "oracle"]},
    "native_reward": {"enum": [0, 1]},
    "repository": {"type": "string", "pattern": "^(?:https://github\\.com/)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"},
    "baseline_commit": {"$ref": "#/$defs/gitSha"},
    "reference_commit": {"$ref": "#/$defs/gitSha"},
    "tested_commit": {"$ref": "#/$defs/gitSha"},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "test_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "test_payload_sha256": {"$ref": "#/$defs/sha256"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "image_id", "platform"],
      "properties": {
        "kind": {"enum": ["docker", "harbor"]},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"const": 0},
    "harbor_result": {"$ref": "#/$defs/binding"},
    "raw_output": {"$ref": "#/$defs/binding"},
    "results": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["test_id", "class", "status"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "class": {"enum": ["F2P", "P2P"]},
          "status": {"enum": ["pass", "fail", "skip", "missing", "error"]}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "fail", "skip", "missing", "error", "flaky", "unexecuted"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "skip": {"const": 0}, "missing": {"const": 0}, "error": {"const": 0},
        "flaky": {"const": 0}, "unexecuted": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}

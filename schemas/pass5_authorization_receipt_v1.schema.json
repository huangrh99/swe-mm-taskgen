{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pass5-authorization-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "nonce", "output_path", "authorization", "frozen_manifest"],
  "properties": {
    "schema_version": {"const": "pass5-authorization-receipt-v1"},
    "status": {"const": "consumed"},
    "run_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "output_path": {"type": "string", "minLength": 1},
    "authorization": {"$ref": "#/$defs/binding"},
    "frozen_manifest": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}

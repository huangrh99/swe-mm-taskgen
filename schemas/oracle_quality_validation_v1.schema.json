{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oracle-quality-validation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "instance_id", "test_manifest_sha256", "status",
    "curator_only", "solver_visible", "negative_variants",
    "equivalent_positive_variant"
  ],
  "properties": {
    "schema_version": {"const": "oracle-quality-validation-v1"},
    "instance_id": {"type": "string", "minLength": 1},
    "test_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "passed"},
    "curator_only": {"const": true},
    "solver_visible": {"const": false},
    "negative_variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "variant_id", "patch_sha256", "result", "expected_reward",
          "observed_reward", "failed_test_ids"
        ],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "patch_sha256": {"$ref": "#/$defs/sha256"},
          "result": {"$ref": "#/$defs/binding"},
          "expected_reward": {"const": 0},
          "observed_reward": {"const": 0},
          "failed_test_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "equivalent_positive_variant": {
      "type": "object", "additionalProperties": false,
      "required": [
        "variant_id", "patch_sha256", "result", "expected_reward",
        "observed_reward", "passed_test_ids"
      ],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "patch_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"$ref": "#/$defs/binding"},
        "expected_reward": {"const": 1},
        "observed_reward": {"const": 1},
        "passed_test_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

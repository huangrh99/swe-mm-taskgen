{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frozen-pass5-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "agent", "agent_version", "provider_profile", "agent_runtime", "valid_trials", "trial_concurrency", "max_invalid_replacements", "expected_test_ids", "harbor_executable", "harbor_executable_sha256", "harbor_version", "harbor_job_config", "network_policy", "tool_policy"],
  "properties": {
    "schema_version": {"const": "frozen-pass5-config-v1"},
    "model_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "provider_profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "base_url", "allowed_host", "credential_env", "capabilities"],
          "properties": {
            "protocol": {"const": "responses"},
            "base_url": {"const": "https://ark-gateway.invalid/api/v3"},
            "allowed_host": {"const": "ark-gateway.invalid"},
            "credential_env": {"const": "ARK_API_KEY"},
            "capabilities": {"const": ["image_in", "thinking"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "allowed_hosts", "credential_source", "capabilities", "compose_overlay"],
          "properties": {
            "protocol": {"const": "codex_cli_chatgpt_auth"},
            "allowed_hosts": {"const": ["api.openai.com", "auth.openai.com", "chatgpt.com"]},
            "credential_source": {"const": "harbor_auth_json"},
            "capabilities": {"const": ["image_in", "thinking"]},
            "compose_overlay": {
              "const": {
                "path": "reproducibility/11_codex_auth_read_search.compose.yaml",
                "sha256": "c96ee46fbc780fd1bca4d93d6d19e2dbf1486813478c344971cdef10afaf6f7d"
              }
            }
          }
        }
      ]
    },
    "agent_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_context_size", "max_completion_tokens", "thinking_effort", "max_steps_per_turn", "timeout_sec", "setup_timeout_sec"],
      "properties": {
        "max_context_size": {"enum": [0, 1048576]},
        "max_completion_tokens": {"enum": [0, 131072]},
        "thinking_effort": {"const": "max"},
        "max_steps_per_turn": {"const": 0},
        "timeout_sec": {"const": 7200},
        "setup_timeout_sec": {"const": 1800}
      }
    },
    "valid_trials": {"const": 5},
    "trial_concurrency": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_invalid_replacements": {"type": "integer", "minimum": 0},
    "expected_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "harbor_executable": {"type": "string", "minLength": 1},
    "harbor_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harbor_version": {"type": "string", "minLength": 1},
    "harbor_job_config": {"$ref": "#/$defs/binding"},
    "network_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_hosts", "agent_hosts"],
      "properties": {
        "environment_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "agent_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "hosted_tools", "mcp_servers", "skills", "forbidden_tools"],
      "properties": {
        "enforcement": {"enum": ["runtime_network_deny_and_trace_rejection", "cli_config_and_trace_rejection"]},
        "hosted_tools": {"enum": ["disabled", "registered_but_runtime_denied_and_trace_rejected"]},
        "mcp_servers": {"const": []},
        "skills": {"const": []},
        "forbidden_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"agent": {"const": "kimi-code"}}, "required": ["agent"]},
      "then": {
        "properties": {
          "network_policy": {
            "properties": {
              "environment_hosts": {"const": []},
              "agent_hosts": {"const": ["ark-gateway.invalid"]}
            }
          },
          "tool_policy": {"const": {
            "enforcement": "runtime_network_deny_and_trace_rejection",
            "hosted_tools": "registered_but_runtime_denied_and_trace_rejected",
            "mcp_servers": [],
            "skills": [],
            "forbidden_tools": ["WebSearch", "FetchURL", "browser", "remote_mcp", "connectors", "file_search"]
          }}
        }
      }
    },
    {
      "if": {"properties": {"agent": {"const": "codex"}}, "required": ["agent"]},
      "then": {
        "properties": {
          "network_policy": {
            "properties": {
              "environment_hosts": {"const": []},
              "agent_hosts": {"const": ["api.openai.com", "auth.openai.com", "chatgpt.com"]}
            }
          },
          "tool_policy": {"const": {
            "enforcement": "cli_config_and_trace_rejection",
            "hosted_tools": "disabled",
            "mcp_servers": [],
            "skills": [],
            "forbidden_tools": ["web_search", "browser", "remote_mcp", "connectors", "file_search"]
          }}
        }
      }
    }
  ],
  "$defs": {"binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
